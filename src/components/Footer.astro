---
import { navLinks } from "./Header.astro";
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-100 text-slate-600 py-12 border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 pb-8 border-b border-slate-200">
      <!-- Brand -->
      <div class="flex items-center gap-3">
        <img src="./nexus_logo.svg" alt="NEXUS LAB Logo" class="w-8 h-8 mr-1" />
        <div>
          <span class="text-lg font-medium text-slate-900 tracking-tight leading-6">NEXUS LAB</span>
          <p class="text-xs text-slate-500 font-medium leading-4">EXPLORE. CONNECT. CREATE IMPACT.</p>
        </div>
      </div>

      <!-- Links -->
      <nav class="flex flex-wrap justify-center gap-6 text-xs sm:text-sm font-bold text-slate-600">
        {navLinks.map(link => (
          <a href={link.href} class="font-semibold hover:text-sky-600">{link.label}</a>
        ))}
      </nav>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4 font-medium">
      <p>&copy; {currentYear} NEXUS LAB / NEXUS SPARK</p>
      <p>Website by <a href="https://github.com/Dev-TRANs" class="font-bold">TRANs</a> / Developed by <a href="https://github.com/ujex256">ujex256</a></p>
    </div>
  </div>
</footer>
