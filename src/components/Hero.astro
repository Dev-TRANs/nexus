              <path d="M236 124 L240 128" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" />
              <path d="M284 124 L280 128" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" />
              <path d="M230 144 L235 144" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" />
