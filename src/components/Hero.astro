              <circle cx="260" cy="142" r="22" fill="url(#heroAmberGold)" />
              <path d="M253 140 L260 132 L267 140 L260 152 Z" fill="#ffffff" />
              <circle cx="260" cy="142" r="7" fill="#ffffff" fill-opacity="0.9" />
              
