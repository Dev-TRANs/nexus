            <g filter="url(#softCardShadow)">
              <rect x="75" y="115" width="52" height="52" rx="14" fill="#ffffff" stroke="#e0f2fe" stroke-width="1.5" />
              <path d="M92 134 C92 129, 97 129, 97 134 C97 138, 107 138, 107 134 C107 129, 112 129, 112 134 L112 148 L88 148 Z" fill="url(#heroSkyBlue)" />
