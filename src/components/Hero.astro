            <path d="M252 245 L258 240 L268 250" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
            <path d="M268 245 L262 250 L252 240" stroke="#f59e0b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />

            <!-- Floating Decorative Geometric Sparks -->
            <circle cx="205" cy="80" r="4" fill="#0284c7" />
            <circle cx="320" cy="75" r="3.5" fill="#f59e0b" />
            <circle cx="100" cy="205" r="3" fill="#38bdf8" />
            <circle cx="430" cy="195" r="4" fill="#6366f1" />
            <polygon points="260,50 263,57 270,60 263,63 260,70 257,63 250,60 257,57" fill="#fbbf24" />
