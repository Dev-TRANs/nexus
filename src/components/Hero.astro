      <!-- Left Column: Copy & Value Proposition -->
      <div class="lg:col-span-3 space-y-7 text-left reveal-left">
        <!-- Title with Underline -->
        <div class="inline-block pb-1.5 border-b-2 border-sky-500">
          <span class="text-sm sm:text-base font-black text-sky-600 tracking-wider">
            学生共創プラットフォーム「NEXUS LAB」
