              <polygon points="145,309 210,309 205,314 150,314" fill="#64748b" />
              <rect x="154" y="279" width="47" height="26" rx="2" fill="#38bdf8" />
              <!-- Code / Design Lines in Laptop (abstract shapes, no text) -->
              <rect x="159" y="284" width="22" height="3" rx="1.5" fill="#ffffff" />
              <rect x="159" y="290" width="34" height="3" rx="1.5" fill="#bae6fd" />
              <rect x="159" y="296" width="16" height="3" rx="1.5" fill="#fef08a" />
