    <!-- Event Teaser Banner -->
    <div class="mt-8 p-6 sm:p-8 rounded-3xl bg-white border border-sky-200/80 shadow-md shadow-sky-950/5 reveal">
      <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="flex items-start gap-4">
          <div class="shrink-0 w-12 h-12 rounded-2xl bg-linear-to-br from-amber-400 to-orange-500 flex items-center justify-center text-white text-2xl shadow-md shadow-orange-500/20">
            🔥
          </div>
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-200">PICK UP EVENT</span>
              <span class="text-xs text-slate-500 font-semibold">2026.08.23 SUN @GROWTH文京飯田橋</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight">
              共創イベント「NEXUS SPARK TOKYO」参加エントリー受付中！
            </h3>
            <p class="text-sm text-slate-600">
              学生団体・学生起業家・企業がつながり、新たな挑戦と共創を生み出す1日。
            </p>
