              <circle cx="416" cy="141" r="16" fill="url(#heroEmerald)" />
              <!-- Rocket Shape -->
              <path d="M416 130 C411 135, 410 144, 410 148 C414 148, 423 147, 428 142 C428 135, 423 130, 416 130 Z" fill="#ffffff" />
              <path d="M410 148 L406 152 M413 141 L417 145" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" />
