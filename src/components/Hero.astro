              <rect x="246" y="178" width="28" height="4" rx="2" fill="#0284c7" />
            </g>

            <!-- LEFT SIDE: Student Creator / Innovator Figure -->
            <g>
              <!-- Student Body -->
              <path d="M85 340 C85 275, 115 255, 145 255 C175 255, 205 275, 205 340 Z" fill="url(#heroSkyBlue)" />
