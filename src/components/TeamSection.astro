---
interface Member {
  name: string;
  role: string;
  message: string;
  imageUrl?: string;
}

const members: Member[] = [
  {
    name: "大湾啓正",
    role: "代表",
    message: `「つながりから、新たな挑戦を生み出す。」
学生団体 NEXUS LAB 代表の大湾 啓正です。

NEXUS LABは、「つながりから、新たな挑戦を生み出す。」という想いのもと、学生・学生団体・企業・スタートアップなど、立場や分野を越えた人々が出会い、新しい挑戦が生まれる場所をつくるために設立しました。

私自身、これまでさまざまな活動に取り組む中で、一つの出会いやつながりが、新しい機会や挑戦へと発展していく瞬間を何度も経験してきました。

一方で、「挑戦したい」という想いを持っていても、仲間や情報、社会との接点がないことで、その一歩を踏み出せない学生も少なくありません。

だからこそNEXUS LABは、単に人を集めるだけのコミュニティではなく、出会った人同士がつながり、そのつながりから実際の行動やプロジェクトが生まれる場所でありたいと考えています。

「NEXUS」は、つながり。
「LAB」は、挑戦と実験の場。

所属する大学も、年齢も、活動している分野も関係ありません。

学生と学生。
学生と企業。
学生とスタートアップ。
そして、まだ出会っていない挑戦者同士。

その間に新しい接点をつくり、そこからこれまでになかった挑戦を生み出していく。

学生だからできること。
学生だからこそ生み出せる熱量。
そして、学生という枠さえ越えて社会と共創していくこと。

NEXUS LABを、誰かの「やってみたい」が「やってみよう」に変わる場所へ。

私たちは、つながりの可能性を信じ、これからも新たな挑戦を生み出し続けます。`,
    imageUrl: "/team/harumasa_owan.jpg",
  },
  {
    name: "平尾美空乃",
    role: "副代表",
    message: `「一緒に考え、一緒につくる楽しさを、たくさんの人へ。」
NEXUS LAB 副代表 平尾美空乃です。

私はNEXUS LABで、メンバーとアイデアを出し合いながら、参加する人に「来てよかった」「また参加したい」と思ってもらえる企画をつくっていきたいです。

誰かの何気ない一言から話が広がったり、自分の考えに別の視点が加わって、思ってもみなかったアイデアが生まれたり。一緒に考えるからこそ生まれるおもしろさを大切にしながら、企画が形になるまでの過程に関わっていきたいと思っています。

NEXUS LABには、大学や分野を越えて、さまざまな興味や想いを持つ人が集まります。自分がこれまで知らなかったことにも触れながら、お互いの「やってみたい」を聞き、一緒に実現する方法を考えていきたいです。私自身も、自分の意見やアイデアを積極的に伝えていきたいと思っています。

特に挑戦したいのは、企画づくりと、広報・パンフレット制作です。

どのような内容なら興味を持ってもらえるのか。当日をどんな気持ちで過ごしてほしいのか。参加する人の姿を思い浮かべながら、企画の内容や演出、伝え方を考えていきたいです。

広報やパンフレットは、活動を初めて知る人との接点にもなります。写真や言葉の選び方、情報を載せる順番など、一つひとつを工夫して、企画に込めた想いや会場の雰囲気が伝わるものをつくりたいです。「楽しそう」「少し気になる」と感じてもらい、参加への一歩につながればうれしいです。

また、実際に参加してくれた人の声にも耳を傾けたいと思っています。どんな場面が楽しかったのか、初めての参加で戸惑ったことはなかったか。そうした声をメンバーと共有しながら、次の企画をよりよいものにしていきたいです。

活動を通して経験を重ね、自分にできることを少しずつ増やしていくことも目標です。周りの人から学び、自分の得意なことを見つけながら、仲間の挑戦を支えられる存在になれたらと思っています。

出会った人とのつながりや、一緒につくる時間を大切に。自分自身も楽しみながら、NEXUS LABで新しいことに挑戦していきます！`,
    imageUrl: "/team/mikuno_hirao.jpg",
  },
  {
    name: "真崎岳",
    role: "副代表",
    message: `「つながりから、新たな挑戦を生み出す。」
学生団体 NEXUS LAB 副代表の真崎 岳です。

私は、これまでさまざまな活動に取り組む中で、出会いの機会や情報との接点が少ないという苦しみの中で今まで活動してきました。
しかしながら、ありがたいことに最近は素晴らしい縁に恵まれています。

現状の学生の中にも「挑戦したい」という想いを持っていて一歩を踏み出せない学生が多く見られます。また、接点を得て学生団体に入ったとしても自分が望んでいたこととのギャップで諦めると言った人も多く見られます。

そんな過去の自分と同じ苦しみを持つ人たちを減らすために今、自分がもてる全てを用いて企業や挑戦者どうしの繋がりを提供します。`,
    imageUrl: "/team/gaku_masaki.jpg",
  },
];
---

<section id="team" class="py-24 border-y border-slate-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl space-y-4 reveal text-left mb-16">
      <div class="inline-block pb-1.5 border-b-2 border-sky-500">
        <span class="text-base sm:text-lg font-black text-sky-600 tracking-wider">
          TEAM INTRODUCTION
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        幹部紹介
      </h2>
    </div>

    <!-- Members Grid -->
    {members.map((member, idx) => (
      <div
        class="bg-white border border-slate-300 rounded-3xl p-7 shadow-xs flex flex-col justify-between reveal mb-6 sm:mb-8"
        style={`transition-delay: ${idx * 100}ms;`}
      >
        <div class="flex flex-col md:flex-row *:min-w-0">
          <div class="flex-1">
            <div class="h-full flex flex-col">
              <p class="text-sm text-slate-500 mt-1">{member.role}</p>
              <h3 class="text-2xl font-bold text-slate-900">{member.name}</h3>
              <div class="grow flex items-center">
                <img src={member.imageUrl!} alt={member.name} loading="lazy" class="p-8 pt-6" />
              </div>
            </div>
          </div>
          <div class="flex-2 content-center">
            <div class="rounded-2xl bg-slate-50 border border-slate-200 p-4.5 sm:p-6 max-h-140 overflow-y-auto">
              <p class="text-slate-700 whitespace-pre-line leading-relaxed text-[15px] sm:text-base">{member.message}</p>
            </div>
          </div>
        </div>
      </div>
    ))}
    {/* <div class="grid grid-cols-1 md:grid-cols-1 gap-6 sm:gap-8">
      {members.slice(1, members.length).map((member, idx) => (
        <div
          class="bg-white border border-slate-300 rounded-3xl p-7 shadow-xs flex flex-col justify-between reveal"
          style={`transition-delay: ${idx * 100}ms;`}
        >
          <div class="flex flex-col md:flex-row *:min-w-0">
            <div class="flex-2">
              <div class="h-full flex items-center justify-center max-h-60">
                <img src={member.imageUrl || "/nexus_logo_full.png"} loading="lazy" class="max-h-full" />
              </div>
            </div>
            <div class="flex-3 ml-4 wrap-anywhere">
              <p class="text-sm text-slate-500 mt-1">{member.role}</p>
              <h3 class="text-2xl font-bold text-slate-900">{member.name}</h3>
              <p class="text-slate-600 mt-2 whitespace-pre-line">{member.message}</p>
            </div>
          </div>
        </div>
      ))}
    </div> --> */ }
  </div>
</section>
