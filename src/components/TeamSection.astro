---
interface Member {
  name: string;
  role: string;
  message: string;
  avatarBg: string;
  avatarIcon: string;
  borderAccent: string;
}

const members: Member[] = [
  {
    name: "大湾啓正",
    role: "代表",
    message: "msg",
    avatarBg: "from-sky-500 to-blue-600",
    avatarIcon: "🚀",
    borderAccent: "hover:border-sky-400"
  },
  {
    name: "佐々木杏奈",
    role: "副代表",
    message: "msg",
    avatarBg: "from-amber-500 to-orange-600",
    avatarIcon: "🌏",
    borderAccent: "hover:border-amber-400"
  },
  {
    name: "ABC",
    role: "役職",
    message: "msg",
    avatarBg: "from-blue-600 to-indigo-700",
    avatarIcon: "💡",
    borderAccent: "hover:border-blue-400"
  },
  {
    name: "ABC",
    role: "役職",
    message: "msg",
    avatarBg: "from-emerald-500 to-teal-600",
    avatarIcon: "🤝",
    borderAccent: "hover:border-emerald-400"
  }
];
---

<section id="team" class="py-24 bg-white border-y border-slate-200/80 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Left-aligned with underline) -->
    <div class="max-w-4xl space-y-4 reveal text-left mb-16">
      <div class="inline-block pb-1.5 border-b-2 border-sky-500">
        <span class="text-base sm:text-lg font-black text-sky-600 tracking-wider uppercase">
          TEAM INTRODUCTION
        </span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        幹部紹介
      </h2>
    </div>

    <!-- Members Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      {members.map((member, idx) => (
        <div
          class={`bg-white border border-slate-200 rounded-3xl p-7 shadow-xs flex flex-col justify-between ${member.borderAccent} group reveal`}
          style={`transition-delay: ${idx * 100}ms;`}
        >
          <div>
            <div class="text-md font-extrabold text-sky-600 mb-3">
              {member.role}
            </div>
            <!-- Avatar / Icon representation -->
            <div class="flex items-center gap-4 mb-6">
              <div class={`w-16 h-16 rounded-2xl bg-linear-to-br ${member.avatarBg} flex items-center justify-center text-3xl text-white shadow-md`}>
                {member.avatarIcon}
              </div>
              <h3 class="text-xl font-bold text-slate-900 leading-snug">
                {member.name}
              </h3>
            </div>

            <!-- Description -->
            <p class="text-sm text-slate-600 leading-relaxed font-medium">
              {member.message}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
